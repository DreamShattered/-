<Window x:Class="FocusFreeze.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多动症矫正器 Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="Card"
                CornerRadius="20"
                Background="#E60D0F14"
                BorderBrush="#59FFFFFF"
                BorderThickness="1"
                Padding="14">
            <StackPanel>
                <Image x:Name="Pic"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="Linear" />
                <TextBlock x:Name="Caption"
                           Margin="0,14,0,4"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#F2FFFFFF"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
